# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# Image tag (frappe/erpnext). Keep in sync with what was tested locally.
ERPNEXT_VERSION=v16.33.0

# MariaDB root password (container-internal, but make it strong).
DB_PASSWORD=change-me-db-root

# Frappe site name. With ENABLE_TLS=false any value works (e.g. "utilnext");
# with ENABLE_TLS=true it is conventional to use the domain name.
SITE_NAME=utilnext

# Public URL users type in the browser (used for realtime/socket origin checks).
#   development on the raw IP:  http://13.x.x.x
#   production with a domain:   https://erp.utilnext.com
PUBLIC_URL=http://CHANGE-ME-ELASTIC-IP

# TLS via Traefik + Let's Encrypt. Needs a real domain whose DNS A record points
# at this server; leave false while running on the bare IP.
ENABLE_TLS=false
SITES_RULE=Host(`erp.utilnext.com`)
LETSENCRYPT_EMAIL=ops@utilnext.com

# Administrator password for the new site (only used on first site creation).
ADMIN_PASSWORD=change-me-admin

# Gunicorn sizing: workers = 2 x vCPU + 1 for production; 2 is enough on a 4 GB dev box.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Ports Traefik publishes (defaults are fine on a dedicated server).
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443
