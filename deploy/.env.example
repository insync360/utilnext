# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# Image tag (frappe/erpnext). Keep in sync with what was tested locally.
ERPNEXT_VERSION=v16.33.0

# MariaDB root password (container-internal, but make it strong).
DB_PASSWORD=change-me-db-root

# Public host name of the site. DNS A record must point at the server.
# The Frappe site is created with exactly this name (Frappe resolves the site by host).
SITE_NAME=erp.utilnext.com
SITES_RULE=Host(`erp.utilnext.com`)

# Let's Encrypt registration email (certificate expiry notices).
LETSENCRYPT_EMAIL=ops@utilnext.com

# Administrator password for the new site (only used on first site creation).
ADMIN_PASSWORD=change-me-admin

# Gunicorn sizing: workers = 2 x vCPU + 1 is the usual rule.
GUNICORN_WORKERS=5
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Ports Traefik publishes (defaults are fine on a dedicated server).
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443
